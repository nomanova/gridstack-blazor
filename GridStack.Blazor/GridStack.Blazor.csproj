<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <ProjectGuid>{3CF74D63-48A2-4837-87AF-806773511D42}</ProjectGuid>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <VersionPrefix>12.4.0</VersionPrefix>
        <Authors>Nomanova</Authors>
        <Copyright>2026 by Nomanova</Copyright>
        <PackageId>Nomanova.GridStack.Blazor</PackageId>
        <PublishRelease>true</PublishRelease>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <OutputType>Library</OutputType>
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <PackageProjectUrl>https://github.com/nomanova/gridstack-blazor</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>gridstack.js;Blazor;dotnet</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <SourceLinkCreate>true</SourceLinkCreate>
        <SourceLinkOriginUrl>https://github.com/nomanova/gridstack-blazor</SourceLinkOriginUrl>
        <NoWarn>1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\LICENSE" Link="LICENSE">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Include="..\README.md" Link="README.md">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
        <PackageReference Include="Microsoft.AspNetCore.Components" Version="8.0.*" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.*" />
    </ItemGroup>

    <ItemGroup Condition=" '$(TargetFramework)' == 'net9.0' ">
        <PackageReference Include="Microsoft.AspNetCore.Components" Version="9.0.*" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.*" />
    </ItemGroup>
    
	<ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
        <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.*" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.*" />
    </ItemGroup>
    
</Project>
